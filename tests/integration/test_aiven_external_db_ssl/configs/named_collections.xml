             coordinates that stay constant across the verify-full / disable /
             hostname-mismatch cases. -->
        <mysql_ssl>
            <host>mysql80</host>
            <port>3306</port>
            <user>root</user>
            <password>ClickHouse_MySQL_P@ssw0rd</password>
            <database>clickhouse</database>
            <table>ssl_probe</table>
        </mysql_ssl>
    </named_collections>
</clickhouse>
