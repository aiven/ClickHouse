<clickhouse>
    <named_collections>
        <!-- Base MySQL collection for the ClickHouse-side SSL assertions. The
             per-query ssl_mode / host overrides are applied in the mysql() table
             function call (allow_named_collection_override_by_default is on by
             default), so this collection only carries what stays constant across
             the verify-full / disable / hostname-mismatch cases.
             `ssl_ca` is a path, so it has to live here: a certificate path is only
             accepted from a named collection defined in a server configuration
             file, never from SQL. The test copies the generated CA to that path
             inside the container before it queries. -->
        <mysql_ssl>
            <host>mysql80</host>
            <port>3306</port>
            <user>root</user>
            <password>ClickHouse_MySQL_P@ssw0rd</password>
            <database>clickhouse</database>
            <table>ssl_probe</table>
            <ssl_ca>/etc/clickhouse-server/aiven_external_db_ca.crt</ssl_ca>
        </mysql_ssl>
    </named_collections>
</clickhouse>
