<clickhouse>
    <!--
        Embedded single-node Keeper with the CREATE_IF_NOT_EXISTS feature flag
        explicitly DISABLED, to simulate a plain Apache ZooKeeper cluster (which
        does not implement that op). All other feature flags keep their Keeper
        defaults (enabled); only create_if_not_exists is turned off.

        Why this faithfully reproduces the real ZooKeeper failure: Keeper's TCP
        handler validates every multi sub-op against the advertised feature flags
        (KeeperContext::isOperationSupported, called from KeeperTCPHandler), so a
        multi containing a CreateIfNotExists (OpNum 502) op is rejected with
        BAD_ARGUMENTS "Unsupported operation: CreateIfNotExists" when the flag is
        off — the server-side equivalent of Apache ZooKeeper failing to
        deserialize op 502.

        We embed a per-node Keeper (instead of the cluster helper's shared
        with_zookeeper=True ensemble) on purpose: the helper's feature-flag
        mechanism can only force-ENABLE or randomize flags, never force one OFF.
        Embedding the Keeper here gives deterministic control. Same rationale as
        patch 050's test (docs/aiven/runbooks/integration-tests.md §7.4.a).
    -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>

        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <!-- For instant start in single node configuration -->
            <heart_beat_interval_ms>0</heart_beat_interval_ms>
            <election_timeout_lower_bound_ms>0</election_timeout_lower_bound_ms>
            <election_timeout_upper_bound_ms>0</election_timeout_upper_bound_ms>
        </coordination_settings>

        <feature_flags>
            <create_if_not_exists>0</create_if_not_exists>
        </feature_flags>

        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <zookeeper>
        <node index="1">
            <host>127.0.0.1</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <macros>
        <shard>shard_no_cine</shard>
        <replica>replica_no_cine</replica>
    </macros>
</clickhouse>
