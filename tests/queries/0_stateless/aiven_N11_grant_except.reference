-- formatting
GRANT SELECT ON *.* EXCEPT SELECT ON system.* TO u
GRANT ALL ON *.* EXCEPT ALL ON system.*, ALL ON information_schema.* TO u
GRANT ON CLUSTER c SELECT ON db.* EXCEPT SELECT ON db.t TO u WITH GRANT OPTION
GRANT CURRENT GRANTS(SELECT ON db.*) EXCEPT SELECT ON db.t TO u
-- syntax errors
GRANT r1, r2 EXCEPT r2 TO u
roles then access types rejected
with roles rejected
with default replicated database privileges rejected
-- table exclusion
GRANT SELECT ON db.* TO u1
REVOKE SELECT ON db.t2 FROM u1
u1 reads t1: 1
u1 reads t2: denied
u1 reads t3: 3
-- database exclusion
GRANT SELECT ON *.* TO u3
REVOKE SELECT ON db.* FROM u3
u3 reads t1: denied
-- with grant option the excluded table is neither readable nor grantable
GRANT SELECT ON db.* TO u2 WITH GRANT OPTION
REVOKE SELECT ON db.t2 FROM u2
u2 reads t1: 1
u2 reads t2: denied
regrant excluded rejected
regrant granted: 
-- equivalent to GRANT and REVOKE
same grants
-- role grantee
GRANT SELECT ON db.* TO r
REVOKE SELECT ON db.t2 FROM r
-- EXCEPT must lie inside the granted access
other table rejected
other privilege rejected
GRANT SELECT ON db.t3 TO u1
-- with replace option
GRANT SELECT ON db.* TO u1
REVOKE SELECT ON db.t2 FROM u1
-- current grants
grant: 
GRANT SELECT ON db.* TO u1
REVOKE SELECT ON db.t2 FROM u1
-- unqualified names resolve to the current database, also on cluster
GRANT SELECT ON db.* TO u1
REVOKE SELECT ON db.t2 FROM u1
GRANT SELECT ON db.* TO u3 WITH GRANT OPTION
REVOKE SELECT ON db.t2 FROM u3
u3 reads t2: denied
-- EXCEPT revokes, so it cannot target the current user
self rejected
GRANT SELECT ON db.* TO granter WITH GRANT OPTION
